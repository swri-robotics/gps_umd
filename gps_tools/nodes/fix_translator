#!/usr/bin/env python3

# Translates from NavSatFix to GPSFix and back

from gps_msgs.msg import GPSFix
import gps_tools.gps_message_converter as converter
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.executors import SingleThreadedExecutor
from rclpy.node import Node
from rclpy.qos import QoSDurabilityPolicy, QoSHistoryPolicy, QoSReliabilityPolicy
from rclpy.qos import QoSProfile
from sensor_msgs.msg import NavSatFix


class FixTranslator(Node):

    def __init__(self):
        super().__init__('fix_translator')
        qos = QoSProfile(
            durability=QoSDurabilityPolicy.TRANSIENT_LOCAL,
            reliability=QoSReliabilityPolicy.RELIABLE,
            history=QoSHistoryPolicy.KEEP_LAST,
            depth=10)
        self.navsat_pub = self.create_publisher(NavSatFix, 'navsat_fix_out', qos_profile=qos)
        self.gps_pub = self.create_publisher(GPSFix, 'gps_fix_out', qos_profile=qos)
        self.navsat_sub = self.create_subscription(
            NavSatFix, 'navsat_fix_in', self.navsat_callback, qos_profile=qos)
        self.gps_sub = self.create_subscription(
            GPSFix, 'gps_fix_in', self.gps_callback, qos_profile=qos)

    def navsat_callback(self, navsat_msg):
        gps_msg = converter.navsatfix_to_gpsfix(navsat_msg)
        self.gps_pub.publish(gps_msg)

    # Translates from GPSFix to NavSatFix.
    # As GPSFix can store much more information than NavSatFix,
    # a lot of this additional information might get lost.
    def gps_callback(self, gps_msg):
        navsat_msg = converter.gpsfix_to_navsatfix(gps_msg)
        self.navsat_pub.publish(navsat_msg)


def main():
    rclpy.init()
    node = None
    executor = None
    try:
        # Built inside the try: rclpy's signal handlers are already installed,
        # so a Ctrl-C or kill that lands while the node is still being set up
        # is a requested shutdown like any other.
        node = FixTranslator()
        executor = SingleThreadedExecutor()
        executor.add_node(node)

        # Wait in short slices rather than indefinitely. rclpy's SIGINT and
        # SIGTERM handling shuts the context down but does not always wake an
        # executor that is already waiting (seen under heavy CPU load), which
        # left the node spinning forever; a bounded wait notices on the next
        # slice.
        while rclpy.ok():
            executor.spin_once(timeout_sec=0.5)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    except Exception:
        # rclpy's SIGINT and SIGTERM handlers shut the context down under spin(),
        # which can surface as an RCLError from the wait set rather than as
        # ExternalShutdownException. Once the context is shut down, that is
        # the requested shutdown, not a failure.
        if rclpy.ok():
            raise
    finally:
        if executor is not None:
            executor.shutdown()
        if node is not None:
            node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
